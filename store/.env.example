# Microsoft Store build configuration for Gestura.
#
#   cp store/.env.example store/.env      (then fill in store/.env)
#
# store/.env is ignored by git: NEVER commit it. Values already present in the real
# environment (for example CI secrets) take precedence over this file.

# --- Package identity: Partner Center > your app > Product management > Product identity
# Not secret, but specific to your account. Must match Partner Center exactly.
GESTURA_STORE_IDENTITY_NAME=
GESTURA_STORE_PUBLISHER=
GESTURA_STORE_PUBLISHER_DISPLAY_NAME=

# --- Submission (only for --submit) — SECRET
# Partner Center > Account settings > User management > Azure AD applications.
MSSTORE_TENANT_ID=
MSSTORE_SELLER_ID=
MSSTORE_CLIENT_ID=
MSSTORE_CLIENT_SECRET=
# Store ID of the product (Product identity page, e.g. 9N...)
MSSTORE_PRODUCT_ID=

# --- Test signing for installing the package on your own PC (only for --sign) — SECRET
# Not needed for the Store: Microsoft signs the submitted package itself.
# The certificate subject must equal GESTURA_STORE_PUBLISHER.
GESTURA_SIGN_CERT_PFX=
GESTURA_SIGN_CERT_PASSWORD=
