{
  "schema_version": 1,
  "camera": {
    "index": 0,
    "width": 640,
    "height": 480,
    "fps": 30,
    "mirror": true,
    "backend": "auto"
  },
  "tracking": {
    "hands_enabled": true,
    "face_enabled": true,
    "num_hands": 2,
    "dominant_hand": "right",
    "min_hand_detection_confidence": 0.6,
    "min_hand_presence_confidence": 0.5,
    "min_tracking_confidence": 0.5,
    "min_face_detection_confidence": 0.5,
    "parallel_inference": true
  },
  "cursor": {
    "anchor": "index_tip",
    "region_left": 0.18,
    "region_right": 0.82,
    "region_top": 0.12,
    "region_bottom": 0.7,
    "speed": 1.0,
    "smoothing_min_cutoff": 1.0,
    "smoothing_beta": 5.0,
    "dead_zone_px": 2,
    "freeze_on_pinch": true,
    "freeze_ratio": 0.4,
    "post_click_freeze_ms": 150
  },
  "hand": {
    "pose_min_frames": 3,
    "pinch_on_ratio": 0.25,
    "pinch_off_ratio": 0.38,
    "pinch_separation": 1.4,
    "pinch_min_frames": 2,
    "click_cooldown_ms": 120,
    "double_click_window_ms": 450,
    "right_click_cooldown_ms": 600,
    "palm_hold_ms": 1200,
    "palm_still_speed": 0.35,
    "pause_cooldown_ms": 2000,
    "scroll_speed": 25.0,
    "scroll_dead_zone": 0.004,
    "scroll_invert": false,
    "volume_steps": 30.0,
    "volume_max_steps_per_frame": 3,
    "two_hand_mouse": false,
    "drag_enabled": true,
    "drag_hold_ms": 450,
    "zoom_enabled": true,
    "zoom_steps": 12.0,
    "zoom_max_steps_per_frame": 2,
    "swipe_min_distance": 0.22,
    "swipe_window_ms": 350,
    "swipe_cooldown_ms": 1000,
    "lost_reset_ms": 250
  },
  "head": {
    "yaw_threshold_deg": 18.0,
    "pitch_down_threshold_deg": 13.0,
    "pitch_up_threshold_deg": 13.0,
    "roll_threshold_deg": 20.0,
    "min_duration_ms": 220,
    "cooldown_ms": 900,
    "rearm_ratio": 0.4,
    "rearm_ms": 150,
    "dominance_ratio": 1.5,
    "smoothing": 0.5,
    "invert_yaw": false,
    "invert_pitch": false,
    "neutral_yaw": 0.0,
    "neutral_pitch": 0.0,
    "neutral_roll": 0.0,
    "calibrated": false
  },
  "face": {
    "pointer": "hybrid",
    "head_range_yaw_deg": 14.0,
    "head_range_pitch_deg": 10.0,
    "head_smoothing_min_cutoff": 0.8,
    "head_smoothing_beta": 4.0,
    "gaze_smoothing_min_cutoff": 0.35,
    "gaze_smoothing_beta": 1.5,
    "gaze_fixation_radius": 0.035,
    "screen_half_angle_deg": 22.0,
    "hybrid_jump_distance": 0.15,
    "hybrid_jump_ms": 250,
    "hybrid_head_gain": 0.6,
    "eye_close_ratio": 0.55,
    "eye_open_ratio": 0.75,
    "wink_other_eye_ratio": 0.65,
    "wink_min_ms": 150,
    "long_wink_ms": 800,
    "long_blink_ms": 600,
    "double_blink_min_ms": 180,
    "double_blink_window_ms": 700,
    "eyes_closed_hold_ms": 2000,
    "freeze_on_blink": true,
    "mouth_open_ratio": 0.35,
    "smile_ratio": 1.12,
    "brow_raise_ratio": 1.18,
    "expression_hold_ms": 300,
    "action_cooldown_ms": 500,
    "dwell_click": false,
    "dwell_ms": 1000,
    "dwell_radius": 0.025,
    "scroll_speed": 15.0,
    "scroll_dead_zone": 0.05,
    "gaze_model": [],
    "gaze_error": 0.0
  },
  "safety": {
    "start_in_test_mode": true,
    "confirm_sensitive": true,
    "confirm_window_ms": 2500,
    "pyautogui_failsafe": true,
    "global_hotkey": true
  },
  "keyboard": {
    "layout": "azerty",
    "scale": 1.0,
    "opacity": 0.95,
    "pos_x": -1,
    "pos_y": -1
  },
  "startup": {
    "launch_at_login": false,
    "auto_start_tracking": false,
    "start_minimized": false,
    "open_page": "dashboard"
  },
  "interface": {
    "show_overlay": true,
    "overlay_position": "top"
  },
  "modes": {
    "mouse": true,
    "navigation": false,
    "keyboard": false,
    "face_mouse": false
  },
  "mappings": {
    "hand": {
      "hand.cursor": "mouse.move",
      "hand.pinch": "mouse.left_click",
      "hand.middle_pinch": "mouse.right_click",
      "hand.scroll": "mouse.scroll",
      "hand.swipe_left": "browser.prev_tab",
      "hand.swipe_right": "browser.next_tab",
      "hand.palm_hold": "app.toggle_pause",
      "hand.volume_up": "media.volume_up",
      "hand.volume_down": "media.volume_down",
      "hand.drag_start": "mouse.drag_start",
      "hand.drag_end": "mouse.drag_end",
      "hand.zoom_in": "view.zoom_in",
      "hand.zoom_out": "view.zoom_out",
      "hand.three_swipe_left": "window.snap_left",
      "hand.three_swipe_right": "window.snap_right"
    },
    "head": {
      "head.turn_left": "browser.back",
      "head.turn_right": "browser.forward",
      "head.nod_down": "key.enter",
      "head.tilt_up": "key.escape",
      "head.roll_left": "none",
      "head.roll_right": "none"
    },
    "face": {
      "face.cursor": "mouse.move",
      "face.scroll": "mouse.scroll",
      "eye.wink_left": "mouse.left_click",
      "eye.wink_right": "mouse.right_click",
      "eye.long_wink_left": "mouse.drag_toggle",
      "eye.long_wink_right": "face.recenter",
      "eye.long_blink": "mouse.double_click",
      "eye.double_blink": "none",
      "eye.closed_hold": "app.toggle_pause",
      "face.mouth_open": "none",
      "face.smile": "none",
      "face.brows_raised": "face.scroll_mode",
      "face.dwell": "mouse.left_click"
    }
  }
}
